# API Keys - Copy this file to .env and add your actual key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=oasis_patient_data

# Model Configuration
# Embeddings use local sentence-transformers (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.0

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
